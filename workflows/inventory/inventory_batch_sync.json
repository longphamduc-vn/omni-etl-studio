{
  "workflow_id": "nexacro_full_pipeline_with_transform",
  "description": "Pipeline 4 bước chuẩn Nexacro Protocol: Search ➔ Fetch Details ➔ Enrichment & Accumulate ➔ Final Report",
  "inputs": [
    {
      "name": "category",
      "label": "Danh mục sản phẩm",
      "type": "string",
      "default": "Thời trang"
    },
    {
      "name": "status",
      "label": "Trạng thái kho",
      "type": "string",
      "default": "IN_STOCK"
    },
    {
      "name": "search_table",
      "label": "Bảng Tra Cứu Mã Sản Phẩm",
      "type": "table",
      "columns": [
        {
          "name": "product_id",
          "label": "Mã Sản Phẩm",
          "type": "string",
          "default": "SP-001"
        }
      ],
      "default": [
        {
          "product_id": "SP-001"
        },
        {
          "product_id": "SP-002"
        }
      ]
    }
  ],
  "steps": [
    {
      "step_id": "step1_search_products",
      "driver": "nexacro",
      "mode": "batch",
      "method": "POST",
      "endpoint": "http://127.0.0.1:8000/api/nexacro/xml/products/search-list",
      "variables": {
        "ds_search": {
          "type": "dataset",
          "columns": [
            {
              "field": "global_input.category",
              "alias": "category"
            },
            {
              "field": "global_input.status",
              "alias": "status"
            }
          ]
        },
        "ds_id_list": {
          "type": "dataset",
          "columns": [
            {
              "field": "global_input.search_table.product_id",
              "alias": "product_id"
            }
          ]
        }
      },
      "transformations": [
        {
          "operator": "handle_nulls",
          "params": {
            "strategy": "drop",
            "subset": [
              "product_id"
            ]
          }
        }
      ],
      "output_dataset": "ds_step1_raw_search",
      "output_config": {
        "display_title": "Bảng Danh Sách Sản Phẩm Tìm Kiếm (Case 1)",
        "columns": [
          {
            "field": "product_id",
            "title": "Mã Sản Phẩm",
            "visible": true
          },
          {
            "field": "product_name",
            "title": "Tên Sản Phẩm",
            "visible": true
          },
          {
            "field": "sku",
            "title": "Mã SKU",
            "visible": true
          },
          {
            "field": "category",
            "title": "Danh Mục",
            "visible": true
          },
          {
            "field": "stock_quantity",
            "title": "Số Lượng Tồn Kho",
            "visible": true
          },
          {
            "field": "sale_price",
            "title": "Giá Bán",
            "visible": true
          }
        ]
      }
    },
    {
      "step_id": "step2_fetch_details_chained",
      "driver": "nexacro",
      "mode": "chained_loop",
      "method": "POST",
      "endpoint": "http://127.0.0.1:8000/api/nexacro/xml/products/detail",
      "loop_source": "ds_step1_raw_search",
      "variables": {
        "ds_condition": {
          "type": "dataset",
          "columns": [
            {
              "field": "loop_row.product_id",
              "alias": "product_id"
            }
          ]
        }
      },
      "transformations": [],
      "output_dataset": "ds_step2_product_details",
      "output_config": {
        "display_title": "Chi Tiết Sản Phẩm Bóc Tách Đa Dataset",
        "columns": [
          {
            "field": "product_id",
            "title": "Mã Sản Phẩm",
            "visible": true
          },
          {
            "field": "product_name",
            "title": "Tên Sản Phẩm",
            "visible": true
          },
          {
            "field": "category",
            "title": "Danh Mục",
            "visible": true
          },
          {
            "field": "brand",
            "title": "Thương Hiệu",
            "visible": true
          },
          {
            "field": "stock_quantity",
            "title": "Tồn Thực Tế",
            "visible": true
          },
          {
            "field": "available_quantity",
            "title": "Khả Dụng",
            "visible": true
          },
          {
            "field": "cost_price",
            "title": "Giá Gốc",
            "visible": true
          },
          {
            "field": "sale_price",
            "title": "Giá Khuyến Mãi",
            "visible": true
          },
          {
            "field": "price_status",
            "title": "Trạng Thái Giá",
            "visible": true
          }
        ]
      }
    },
    {
      "step_id": "step3_data_enrichment_accumulate",
      "driver": "passthrough",
      "mode": "batch",
      "method": "POST",
      "endpoint": "",
      "transformations": [
        {
          "operator": "add_date_column",
          "params": {
            "target_column": "created_date",
            "date_source": "current_timestamp"
          }
        },
        {
          "operator": "accumulate_data",
          "params": {
            "target_history_table": "ds_historical_products_v2",
            "dedup_keys": [
              "product_id"
            ],
            "order_by": "created_date DESC"
          }
        },
        {
          "operator": "sql_transform",
          "params": {
            "where_clause": "CAST(product_id AS VARCHAR) = '$.global_input.search_table.product_id'"
          }
        }
      ],
      "output_dataset": "ds_step3_accumulated_clean",
      "output_config": {
        "display_title": "Dữ Liệu Tích Lũy / Cập Nhật Mới Nhất",
        "columns": [
          {
            "field": "product_id",
            "title": "Mã Sản Phẩm",
            "visible": true
          },
          {
            "field": "product_name",
            "title": "Tên Sản Phẩm",
            "visible": true
          },
          {
            "field": "category",
            "title": "Danh Mục",
            "visible": true
          },
          {
            "field": "sale_price",
            "title": "Giá Bán",
            "visible": true
          },
          {
            "field": "created_date",
            "title": "Ngày Cập Nhật Mới Nhất",
            "visible": true
          }
        ]
      }
    },
    {
      "step_id": "step4_analytics_final_report",
      "driver": "passthrough",
      "mode": "batch",
      "method": "POST",
      "endpoint": "",
      "variables": {},
      "transformations": [
        {
          "operator": "group_by",
          "params": {
            "by": [
              "category"
            ],
            "agg": {
              "product_id": "COUNT"
            }
          }
        }
      ],
      "output_dataset": "ds_step4_final_report",
      "output_config": {
        "display_title": "Báo Cáo Tổng Hợp Sản Phẩm Theo Danh Mục",
        "columns": [
          {
            "field": "category",
            "title": "Danh Mục",
            "visible": true
          },
          {
            "field": "product_id_COUNT",
            "title": "Tổng Số Lượng",
            "visible": true
          }
        ]
      }
    }
  ]
}   