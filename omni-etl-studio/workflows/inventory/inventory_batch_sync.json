{
  "workflow_id": "inventory_batch_sync",
  "description": "Batch sync of warehouse items with DuckDB SQL group-by aggregations.",
  "steps": [
    {
      "step_id": "sync_warehouse_items",
      "driver": "nexacro",
      "mode": "batch",
      "endpoint": "http://127.0.0.1:8088/nexacro/inventory",
      "variables": {
        "warehouse_id": {
          "jsonpath": "$.global_input.warehouse_id",
          "value": "WH-01"
        }
      },
      "filters": [],
      "transformations": [
        {
          "operator": "group_by",
          "params": {
            "by": ["category"],
            "agg": {
              "quantity": "SUM"
            }
          }
        }
      ],
      "output_dataset": "category_inventory_summary"
    }
  ]
}