{
  "workflow_id": "academic_student_score_chained",
  "description": "Fetches active students in batch mode, then sequentially fetches individual scores in chained loop mode.",
  "steps": [
    {
      "step_id": "fetch_student_list",
      "driver": "nexacro",
      "mode": "batch",
      "endpoint": "http://127.0.0.1:8088/nexacro/students",
      "variables": {
        "dept_code": {
          "jsonpath": "$.global_input.dept_code",
          "value": "CS"
        },
        "academic_year": {
          "value": "2026"
        }
      },
      "filters": [
        {
          "field": "status",
          "operator": "==",
          "value": "ACTIVE"
        }
      ],
      "transformations": [],
      "output_dataset": "active_students"
    },
    {
      "step_id": "fetch_scores_chained",
      "driver": "nexacro",
      "mode": "chained_loop",
      "endpoint": "http://127.0.0.1:8088/nexacro/scores",
      "variables": {
        "loop_source": {
          "value": "active_students"
        },
        "student_id": {
          "jsonpath": "$.loop_row.student_id"
        }
      },
      "filters": [
        {
          "field": "score",
          "operator": ">=",
          "value": 50
        }
      ],
      "transformations": [
        {
          "operator": "deduplicate",
          "params": {
            "subset": ["student_id", "subject_code"]
          }
        }
      ],
      "output_dataset": "passed_student_scores"
    }
  ]
}